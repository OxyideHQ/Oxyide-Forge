generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id
  email       String      @unique
  displayName String?
  status      String      @default("active")
  role        String      @default("user")
  emailVerifiedAt DateTime?
  lockedUntil DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  credential  Credential?
  sessions    Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notes       Note[]
}

model Credential {
  id           String   @id
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
}

model Session {
  id        String    @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id           String       @id
  sessionId    String
  tokenHash    String       @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  supersededBy String?    @unique
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  successor    RefreshToken? @relation("TokenSuccession", fields: [supersededBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  predecessor  RefreshToken? @relation("TokenSuccession")

  @@index([sessionId])
  @@index([expiresAt])
}

model LoginThrottle {
  key             String   @id
  failureCount    Int
  windowStartedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model Note {
  id          String   @id
  userId      String
  title       String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}
