HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://test:test@127.0.0.1:5433/oxyide_starter
JWT_SECRET=replace-with-at-least-32-characters
# Runtime environment: development | test | production. Optional, defaults to
# development. Production enables the strictest gates (HTTPS base URL, DB
# sslmode=require, Secure cookies, Swagger UI off, cookie auth disabled).
# Example: NODE_ENV=production
# Optional Redis: redis:// or rediss:// URL. Absent = no Redis (the
# application starts and fully functions without it). Never set an empty
# string — REDIS_URL="" is a startup error, not "disabled".
# Example: REDIS_URL=redis://localhost:6379
# Public base URL used to build absolute links (e.g. password-recovery links).
# Optional: defaults to http://localhost:3000. Production REQUIRES https://.
# Never derived from request Host/Origin headers.
# Example: APP_BASE_URL=https://app.example.com

# Optional SMTP email transport: all five variables form one group.
# Absent = email stays on the NoOp provider (validates, delivers nothing).
# Any SMTP_* without SMTP_HOST, a missing PORT/SECURITY with SMTP_HOST set,
# a lone SMTP_USER or SMTP_PASSWORD, and credentials with plaintext transport
# all reject at startup — partial groups never construct a broken provider.
# SMTP_HOST: mail server hostname or IP (required to enable SMTP).
# SMTP_PORT: TCP port, 1-65535 (required; no assumed 587).
# SMTP_USER / SMTP_PASSWORD: authentication pair, both or neither.
# Passwords are NOT trimmed (surrounding spaces are valid in secrets).
# SMTP_SECURITY: smtps (implicit TLS, typically 465) | starttls
# (STARTTLS required, typically 587) | plaintext (development relays
# only, e.g. local Mailhog — rejected whenever credentials are set).
# Sender: derived from APP_BASE_URL as `no-reply@<host>`. There is
# deliberately no SMTP_FROM — every message carries a required `from`
# (frozen contract), and a second sender source would be dead
# configuration with ambiguous precedence. Align APP_BASE_URL with your mail
# domain, or the sender host will not match your provider's expectations.
# Example: SMTP_HOST=smtp.example.com
# Example: SMTP_PORT=587
# Example: SMTP_SECURITY=starttls
# Example: SMTP_USER=forge (only with SMTP_PASSWORD; both or neither)
# Example: SMTP_PASSWORD=correct-horse-battery-staple (placeholder only — never a real secret)

# Optional CORS allowlist: comma-separated bare http(s)://host[:port]
# origins. Absent = CORS fully disabled (no cross-origin headers emitted).
# Each entry must be a bare origin — no paths, queries, fragments,
# credentials, or non-http(s) schemes. Empty entries reject at startup.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
# CORS_ALLOWED_ORIGINS=

# Optional DATABASE_URL parameters (validated at startup when present):
# ?connection_limit=10 pool connections per instance, positive integer >= 1
# &pool_timeout=10 seconds waiting for a free connection, positive integer >= 1
# &connect_timeout=5 seconds establishing a connection, positive integer >= 1
# &sslmode=require TLS policy: require or disable only (verify-ca/verify-full
# are silently ignored by Prisma and therefore rejected).
# Production REQUIRES sslmode=require.
# Example: DATABASE_URL=postgresql://test:test@127.0.0.1:5433/oxyide_starter?connection_limit=10&sslmode=require

# API documentation: OpenAPI 3.1 document + Swagger UI. Strict
# booleans only — `true`/`false` (surrounding whitespace tolerated);
# `1`/`yes`/anything else rejects at startup. The pair is validated
# together: Swagger UI without the OpenAPI document is rejected.
# OPENAPI_ENABLED: serve the machine-readable document at /openapi.json.
# Default true in every environment (the document is public API surface).
# SWAGGER_UI_ENABLED: serve the developer UI at /docs (backed by the same
# document — no second definition). Default true except production
# (developer interface off where unneeded); set false to hide the UI
# while keeping /openapi.json.
# Example: OPENAPI_ENABLED=true
# Example: SWAGGER_UI_ENABLED=true

# Operational metrics (M14.3): Prometheus-compatible exporter at GET /metrics.
# Opt-in and OFF by default; when true the app records bounded HTTP request,
# error, and duration metrics (labels: method, route-template, status only —
# never raw URLs, IDs, emails, IPs, tokens, or query strings) and serves them in
# the Prometheus text exposition format for scraping. Safe to run in any
# environment; leave disabled if you route metrics through another stack.
# Example: METRICS_ENABLED=true
